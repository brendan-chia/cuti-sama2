INVITE_BASE_URL=https://your-domain.example

# Server-side only. Copy into supabase/.env.local for local Edge Functions.
# Hosted functions read these from Supabase Dashboard > Edge Functions > Secrets.
ELEVENLABS_API_KEY=
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2
GROQ_API_KEY=
GROQ_STRUCTURED_OUTPUT_MODEL=openai/gpt-oss-20b
GROQ_ITINERARY_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Saved reels / Saved inspiration: direct OpenAI Responses API.
INSPIRATION_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_INSPIRATION_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# Audio uses OpenAI whisper-1 for timestamped transcription.

# Online Explore recommendations: OpenAI web search and map lookup.
OPENAI_EXPLORE_MODEL=gpt-4.1-mini

# Suggested stays, including accommodation options used by budget recommendations.
OPENAI_STAYS_MODEL=gpt-4.1-mini
